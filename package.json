{
  "name": "shiftlands",
  "version": "1.0.0",
  "description": "A persistent cooperative world of shifting islands, built for GitHub Game Off 2026.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "npm run check && npm run build && npm test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kdaigle/shiftlands"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
